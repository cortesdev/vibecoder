// Vibecoder license service — SQLite for zero-setup; the datasource is
// portable to postgres when this outgrows a single box.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model License {
  id             String    @id @default(cuid())
  key            String    @unique
  email          String
  stripeSessionId String   @unique // idempotency: one license per checkout
  stripePaymentIntent String @default("")
  // Keys prefixed TEST- come from demo checkout (Stripe test mode, no money).
  // The validate endpoint accepts them; the success page labels them.
  status         String    @default("active") // active | revoked
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  activations    LicenseActivation[]
}

model LicenseActivation {
  id        String   @id @default(cuid())
  licenseId String
  machineId String // hashed machine fingerprint from the desktop app
  label     String   @default("") // e.g. "Ricardo's MacBook"
  createdAt DateTime @default(now())

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, machineId])
  @@index([licenseId])
}

// ── Vibecoder Projects — Google sign-in + Bolt-style project folders ────────

model User {
  id        String   @id @default(cuid())
  googleSub String   @unique // stable Google subject id
  email     String   @unique
  name      String   @default("")
  image     String   @default("")
  createdAt DateTime @default(now())

  sessions Session[]
  projects Project[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 of the raw cookie value; we never store the raw token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id        String        @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  files    ProjectFile[]
  prompts  Prompt[]
  changes  Change[]

  @@index([userId])
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String // repo-relative, e.g. "src/App.tsx"
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

model Prompt {
  id        String   @id @default(cuid())
  projectId String
  content   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changes Change[]

  @@index([projectId])
}

model Change {
  id        String   @id @default(cuid())
  projectId String
  promptId  String?
  path      String
  before    String
  after     String
  status    String   @default("pending") // pending | applied | reverted
  createdAt DateTime @default(now())
  appliedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompt  Prompt?  @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([promptId])
}
