// Vibecoder license service — SQLite for zero-setup; the datasource is
// portable to postgres when this outgrows a single box.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

model License {
  id             String    @id @default(cuid())
  key            String    @unique
  email          String
  stripeSessionId String   @unique // idempotency: one license per checkout
  stripePaymentIntent String @default("")
  // Keys prefixed TEST- come from demo checkout (Stripe test mode, no money).
  // The validate endpoint accepts them; the success page labels them.
  status         String    @default("active") // active | revoked
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  activations    LicenseActivation[]
}

model LicenseActivation {
  id        String   @id @default(cuid())
  licenseId String
  machineId String // hashed machine fingerprint from the desktop app
  label     String   @default("") // e.g. "Ricardo's MacBook"
  createdAt DateTime @default(now())

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, machineId])
  @@index([licenseId])
}

// ── Vibecoder Projects — Google sign-in + Bolt-style project folders ────────

model User {
  id        String   @id @default(cuid())
  googleSub String   @unique // stable Google subject id
  email     String   @unique
  name      String   @default("")
  image     String   @default("")
  role      String   @default("user")
  createdAt DateTime @default(now())

  sessions Session[]
  projects Project[]
  keys     UserKey[]
  wallet   CreditWallet?
  creditTxns CreditTxn[]
  serviceKeys ServiceKey[]
  freeWallet FreeWallet?
  freeTxns  FreeTxn[]
  freeCooldown FreeCooldown?
  learningRecords AgentLearning[]
}

model AgentLearning {
  id          String   @id @default(cuid())
  scope       String   @default("global")
  status      String   @default("pending")
  kind        String
  ciphertext  String
  iv          String
  authTag     String
  keyVersion  String   @default("v1")
  createdById String?
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([scope, status])
  @@index([status, createdAt])
  @@index([createdById])
}

// BYO API keys for free models (e.g. a free Z.ai key for GLM Flash).

// Server-side only; never sent back to the client after save.
model UserKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String // zai | anthropic | openai
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// Credits pay for platform-hosted paid models. 1 credit ≈ $0.10; credit
// prices are ~2× our raw provider cost — the 50% platform margin.
model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Append-only ledger. (reason, ref) is unique so Stripe retries and double
// debits can never double-apply.
model CreditTxn {
  id        String   @id @default(cuid())
  userId    String
  delta     Int // negative = spend, positive = purchase/refund
  reason    String // purchase | model_run | refund
  ref       String @default("")
  note      String @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reason, ref])
  @@index([userId])
}

// Integrations: service credentials (API keys) a user connects from the
// Integrations catalog. Key values server-side only, like UserKey.
model ServiceKey {
  id          String   @id @default(cuid())
  userId      String
  serviceSlug String // slug in src/lib/integrations.ts
  label       String   @default("Primary") // e.g. "Primary", "Staging"
  key         String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serviceSlug])
}

// Free-token wallet: a finite sign-up allowance (e.g. 50,000 tokens) that pays
// for hosted (credits-tier) model runs BEFORE credits do. 1 credit ≈ 10,000
// free tokens. The wallet never covers free-tier models — those are free by
// definition. When it's empty, hosted runs bill credits (free path reopens
// only for the always-free models).
model FreeWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  granted   Int      @default(0) // the sign-up allowance
  balance   Int      @default(0) // remaining free tokens
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Append-only ledger, mirror of CreditTxn. (reason, ref) unique = idempotent.
model FreeTxn {
  id        String   @id @default(cuid())
  userId    String
  delta     Int // negative = spent on a run, positive = sign-up grant
  reason    String // grant | consume
  ref       String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reason, ref])
  @@index([userId])
}

// Per-user cooldown for the always-free models: after one free answer, the
// first question is gated until nextAllowedAt so a shared free quota (one
// platform key, many users) is not drained by a single user hammering it.
// DB-backed, not in-memory: the site runs on serverless instances where a
// Map would be per-instance and meaningless. A row exists only while a
// cooldown is active; upsert adds/extends it, and delete clears it after
// the wait so the row count stays bounded by concurrent cooldowns.
model FreeCooldown {
  id            String   @id @default(cuid())
  userId        String   @unique
  nextAllowedAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 of the raw cookie value; we never store the raw token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id        String        @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  files    ProjectFile[]
  prompts  Prompt[]
  changes  Change[]

  @@index([userId])
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String // repo-relative, e.g. "src/App.tsx"
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

model Prompt {
  id         String   @id @default(cuid())
  projectId  String
  content    String
  // Chat-thread fields: role distinguishes the user's message from the
  // agent's reply, so /agent/projects/[id] can render a real conversation.
  role       String   @default("user") // user | assistant
  mode       String   @default("build") // build | plan | mission | skills
  modelId    String   @default("")
  modelLabel String   @default("")
  error      String   @default("")
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changes Change[]

  @@index([projectId])
}

model Change {
  id        String   @id @default(cuid())
  projectId String
  promptId  String?
  path      String
  before    String
  after     String
  status    String   @default("pending") // pending | applied | reverted
  createdAt DateTime @default(now())
  appliedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompt  Prompt?  @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([promptId])
}
