{"nodes": [{"id": "docs_superpowers_plans_2026_09_23_code_replica_guide", "label": "Opencode Replica Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-23-code-replica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_09_23_code_replica_transport_abstraction", "label": "Transport Abstraction", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-23-code-replica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single Transport contract decouples the React terminal UI from WebSocket and Electron IPC implementations while preserving identical connect, write, resize, and event behavior."}, {"id": "docs_superpowers_plans_2026_09_23_code_replica_pty_backed_opencode", "label": "PTY-Backed Opencode", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-23-code-replica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both surfaces wrap the real opencode CLI through node-pty rather than reimplementing the agent, with missing-binary and PATH override handling."}, {"id": "docs_superpowers_plans_2026_09_23_code_replica_dual_surface_delivery", "label": "Dual-Surface Delivery", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-23-code-replica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same terminal experience is delivered through a browser-served Vite app at /code and an Electron arm64 DMG at /releases."}, {"id": "docs_superpowers_plans_2026_09_23_code_replica_security_and_failure_constraints", "label": "Replica Security and Failure Constraints", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-23-code-replica.md", "source_location": null,