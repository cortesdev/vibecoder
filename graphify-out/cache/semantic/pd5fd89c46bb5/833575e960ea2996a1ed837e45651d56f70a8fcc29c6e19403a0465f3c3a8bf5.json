{"nodes": [{"id": "agent_skills_constraint_driven_development_skill_written_quality_contract", "label": "Written Quality Contract", "file_type": "rationale", "source_file": "agent/skills/constraint-driven-development/SKILL.md", "source_location": "L8-L14,L91-L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A written, command-backed quality contract makes the project bar durable across agents and separates enforceable numbers from aspirations."}, {"id": "agent_skills_constraint_driven_development_skill_guard_the_quality_bar", "label": "Guard the Quality Bar", "file_type": "rationale", "source_file": "agent/skills/constraint-driven-development/SKILL.md", "source_location": "L200-L222", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Review should loudly catch lowered thresholds, easier tests, silenced checkers, unfinished work, and untracked exceptions while silent changes tighten the bar."}, {"id": "agent_skills_constraint_driven_development_skill_ratchets_and_cost_placement", "label": "Quality Ratchets and Check Cost Placement", "file_type": "rationale", "source_file": "agent/skills/constraint-driven-development/SKILL.md", "source_location": "L184-L198,L224-L248", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fast checks belong near edits, expensive checks belong later, and measured ratchets prevent unstated quality regression."}], "edges": [{"source": "agent_skills_constraint_driven_development_skill_written_quality_contract", "target": "agent_skills_ci_cd_and_automation_skill_quality_gate_pipeline", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "agent/skills/constraint-driven-development/SKILL.md", "source_location": "L91-L138", "weight": 1.0}, {"source": "agent_skills_constraint_driven_development_skill_guard_the_quality_bar", "target": "agent_skills_constraint_drive