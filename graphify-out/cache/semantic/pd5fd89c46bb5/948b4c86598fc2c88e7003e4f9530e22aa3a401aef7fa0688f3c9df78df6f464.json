{"nodes": [{"id": "src_app_icon_asset", "label": "VibeCoder Application Icon", "file_type": "image", "source_file": "src/app/icon.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_app_icon_three_component_abstract_mark", "label": "Three-Component Abstract Mark", "file_type": "concept", "source_file": "src/app/icon.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 19 by 19 image contains a vivid red abstract mark made from three broad, rounded components separated by clear negative spaces; it is a compact geometric logomark rather than text, a scene, or a data visualization."}, {"id": "src_app_icon_coral_red_palette", "label": "Coral-Red Monochrome Palette", "file_type": "concept", "source_file": "src/app/icon.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The visible pixels use a single vivid coral-red hue centered around #fd3535; the slight RGB differences are edge anti-aliasing and alpha variation rather than separate colored elements."}, {"id": "src_app_icon_transparent_canvas", "label": "Transparent Alpha Canvas", "file_type": "concept", "source_file": "src/app/icon.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The PNG is 19 by 19 with an RGBA alpha channel and no opaque background rectangle, leaving the mark isolated for compositing on different interface backdrops."}, {"id": "src_app_icon_compact_web_brand_icon", "label": "Compact Web Brand Icon", "file_type": "concept", "source_file": "src/app/icon.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tiny dimensions, simple flat-color silhouette, and transparent edges make the asset suitable for small browser or application placements; the 