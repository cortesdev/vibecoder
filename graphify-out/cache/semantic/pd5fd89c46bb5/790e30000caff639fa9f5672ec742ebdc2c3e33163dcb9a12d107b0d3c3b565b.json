{"nodes": [{"id": "public_vibe_logo_asset", "label": "VibeCoder Logo Asset", "file_type": "image", "source_file": "public/vibe-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_vibe_logo_three_component_abstract_mark", "label": "Three-Component Abstract Mark", "file_type": "concept", "source_file": "public/vibe-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 19 by 19 image contains a vivid red abstract mark made from three broad, rounded components separated by clear negative spaces; it is a compact geometric logomark rather than text, a scene, or a data visualization."}, {"id": "public_vibe_logo_coral_red_palette", "label": "Coral-Red Monochrome Palette", "file_type": "concept", "source_file": "public/vibe-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The visible pixels use a single vivid coral-red hue, centered around #fd3535; the slight RGB differences are edge anti-aliasing and alpha variation rather than separate colored elements."}, {"id": "public_vibe_logo_transparent_canvas", "label": "Transparent Alpha Canvas", "file_type": "concept", "source_file": "public/vibe-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The PNG is 19 by 19 with an RGBA alpha channel and no opaque background rectangle, leaving the mark isolated for compositing on different interface backdrops."}, {"id": "public_vibe_logo_compact_web_brand_icon", "label": "Compact Web Brand Icon", "file_type": "concept", "source_file": "public/vibe-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tiny dimensions, simple flat-color silhouette, and transparent edges make the asset suitable for small browser or application placements such as a favicon, app icon, or wordmark mark; the exact consuming surface is not encoded in the PNG."}, {"id": "public_vibe_logo_vibecoder_brand_identity", "label": "VibeCoder Brand Identity", "file_type": "concept", "source_file": "public/vibe-logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The vibe-logo.png filename and standalone public-asset placement indicate that the mark represents VibeCoder's visual identity; the image itself contains no written wordmark."}], "edges": [{"source": "public_vibe_logo_asset", "target": "public_vibe_logo_three_component_abstract_mark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/vibe-logo.png", "source_location": null, "weight": 1.0}, {"source": "public_vibe_logo_asset", "target": "public_vibe_logo_coral_red_palette", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/vibe-logo.png", "source_location": null, "weight": 1.0}, {"source": "public_vibe_logo_asset", "target": "public_vibe_logo_transparent_canvas", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/vibe-logo.png", "source_location": null, "weight": 1.0}, {"source": "public_vibe_logo_asset", "target": "public_vibe_logo_compact_web_brand_icon", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "public/vibe-logo.png", "source_location": null, "weight": 1.0}, {"source": "public_vibe_logo_asset", "target": "public_vibe_logo_vibecoder_brand_identity", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "public/vibe-logo.png", "source_location": null, "weight": 1.0}, {"source": "public_vibe_logo_three_component_abstract_mark", "target": "public_vibe_logo_vibecoder_brand_identity", "relation": "conceptually_related_to", "confidence"